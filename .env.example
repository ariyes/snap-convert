# Cookie-free usage counting with our self-hosted Umami (src/lib/analytics, P23).
# Copy to .env (never committed) and fill in both to turn counting on; leave either empty to keep it off.
# Read at build time only. Vite passes only VITE_-prefixed variables to the app.

# Base URL of our own Umami server (https), e.g. https://crkayes.com/umami
VITE_UMAMI_URL=
# The website id Umami shows for Snap Convert (a UUID)
VITE_UMAMI_WEBSITE_ID=
