{
  "name": "snap-convert",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open-source image, PDF and RAW converter that runs entirely in the browser.",
  "license": "AGPL-3.0-only",
  "sideEffects": [
    "*.css",
    "src/app/entry.*"
  ],
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview",
    "lint": "react-router typegen && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run --project unit --project browser",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:perf": "node scripts/test-perf.ts",
    "e2e": "playwright test",
    "e2e:all": "node scripts/e2e-all.ts",
    "quality": "vitest run --project quality --passWithNoTests",
    "fixtures:raw": "node scripts/fixtures-raw.ts"
  },
  "dependencies": {
    "@colorhythm/libraw-wasm": "1.1.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/webp": "1.5.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "comlink": "4.4.2",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "flashraw": "0.3.1",
    "libheif-js": "1.23.5",
    "lucide-react": "1.73.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pica": "10.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "workbox-window": "7.4.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
