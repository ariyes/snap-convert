# Snap Convert deploy settings (P25). Copy to deploy/.env — that file is git-ignored.
# Server address, login name and folder only. NEVER put passwords, private keys or tokens here:
# log in with an SSH key (ssh-agent remembers its passphrase).
# One setting per line, no comments after a value.

# Server name or IP, or a Host alias from ~/.ssh/config (then DEPLOY_USER can stay empty)
DEPLOY_HOST=
# SSH login name on the server
DEPLOY_USER=
# SSH port (22 if empty)
DEPLOY_PORT=22
# Optional: path to the private key file if it isn't your default one (the path, not the key)
DEPLOY_SSH_KEY=

# Folder on the server that holds releases/, current and security-headers.conf.
# Must match the paths in deploy/nginx-snap-convert.conf.
DEPLOY_PATH=/var/www/snap-convert
# Releases kept on the server (the live one is never deleted)
DEPLOY_KEEP=3
# Checks and reloads nginx after a switch. The login needs passwordless sudo for exactly these
# two commands (see docs/launch/checklist.md). Must not contain " $ ` or \
DEPLOY_RELOAD=sudo -n nginx -t && sudo -n systemctl reload nginx

# 1 = send the CSP as Content-Security-Policy-Report-Only (try it for a day; violations then
# show in the browser console without blocking anything). 0 or empty = enforce.
DEPLOY_CSP_REPORT_ONLY=0
# The Strict-Transport-Security value the rest of crkayes.com sends, if any
# (curl -sI https://crkayes.com/ | grep -i strict-transport). Empty = not sent by /snap-convert/.
DEPLOY_HSTS=
